+                    }
+                } else Modifier
+            )
+            .onGloballyPositioned { coordinates ->
+                buttonBounds = coordinates.boundsInRoot()
+            }
+            .padding(LocalKeyVisualPadding.current)
+            .then(shadowModifier)
+            .clip(keyClipShape)
+            .background(
