+                                isPressed = true
+                                dragOffsetY = 0f
+                                dragOffsetX = 0f
+                                hasTriggeredSwipeUp = false
+                                hasTriggeredSwipeDown = false
+                                hasTriggeredSwipeLeft = false
+                                hasTriggeredSwipeRight = false
+                                isSwiping = false
